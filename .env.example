# Copy this file to .env and fill in real values.
# .env itself should NEVER be committed to git (add it to .gitignore).

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=streaming_analytics
MYSQL_HOST=mysql
MYSQL_USER=root
MYSQL_PASSWORD=changeme

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ---- Producer ----
PRODUCER_DELAY_SECONDS=0.3

# ---- Anomaly detection (Phase 2) ----
# How many standard deviations from a metric's own recent history counts
# as anomalous. Lower = more sensitive (more alerts, more false positives).
ANOMALY_Z_THRESHOLD=2.0
# How many prior windows (per consumer instance) to use as the "normal" baseline.
ANOMALY_LOOKBACK_WINDOWS=20

# ---- RFM Customer Segmentation (Phase 3) ----
# How often (seconds) to recompute every customer's RFM score and segment.
SEGMENTATION_INTERVAL_SECONDS=60
# Minimum distinct customers with purchase history before scoring starts
# (quintile scoring is meaningless with too few customers).
MIN_TRANSACTIONS_TO_SCORE=5

# ---- Grafana ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# ---- Grafana SMTP (for email alerts -- Phase 2) ----
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=your-email@gmail.com
GF_SMTP_PASSWORD=your-app-password
GF_SMTP_FROM_ADDRESS=your-email@gmail.com
ALERT_NOTIFICATION_EMAIL=your-email@gmail.com

# ---- Logging ----
LOG_LEVEL=INFO
